    <string name="at_nickname">@%1$s</string>
    <string name="at_symbol">@</string>
    <string name="back">பின்</string>
    <string name="background_location_explanation">ஆப் திறக்கப்படாதபோதும் அருகிலுள்ள சாதனங்களை ஸ்கேன் செய்ய Meshora க்கு பின்னணி இருப்பிடத்தை Android பரிந்துரைக்கிறது. இது ரீபூட்டிற்குப் பிறகும் மெஷை உயிருடன் வைத்திருக்கும்.</string>
    <string name="background_location_needs_bullets">- ஆப் மூடப்பட்டிருக்கும்போது அருகிலுள்ள சாதனங்களை ஸ்கேன் செய்ய\n- ரீபூட்டிற்குப் பிறகு மீண்டும் இணைக்க\n- மெஷை பின்னணியில் இயங்க வைக்க</string>
    <string name="background_location_needs_for">Meshora பின்னணி இருப்பிடத்தைப் பயன்படுத்துவது:</string>
    <string name="background_location_privacy_note">உங்கள் இருப்பிடத்தை நாங்கள் ஒருபோதும் சேகரிக்கவோ சேமிக்கவோ மாட்டோம். உங்கள் தனியுரிமை பாதுகாப்பானது.</string>
    <string name="background_location_required_subtitle">விருப்பத்தேர்வு, மெஷ் நம்பகத்தன்மையை மேம்படுத்துகிறது</string>
    <string name="background_location_required_title">பின்னணி இருப்பிடம் பரிந்துரைக்கப்படுகிறது</string>
    <string name="background_location_settings_tip">அமைப்புகள் திறக்கும்போது, "எப்போதும் அனுமதிக்கவும்" என்பதைத் தேர்ந்தெடுக்கவும்.</string>
    <string name="battery_benefits_short">• நம்பகமான செய்தி வழங்கல்\n• மெஷ் இணைப்பைப் பராமரிக்கிறது\n• இணைப்பு துண்டிப்புகளைத் தடுக்கிறது</string>
    <string name="battery_optimization_benefits">• நம்பகமான செய்தி வழங்கலை உறுதி செய்கிறது\n• மெஷ் நெட்வொர்க் இணைப்பைப் பராமரிக்கிறது\n• பின்னணி செய்தி அனுப்புதலை அனுமதிக்கிறது\n• இணைப்பு துண்டிப்புகளைத் தடுக்கிறது</string>
    <string name="battery_optimization_check_again">மீண்டும் சரிபார்க்கவும்</string>
    <string name="battery_optimization_checking">பேட்டரி ஆப்டிமைசேஷனைச் சரிபார்க்கிறது</string>
    <string name="battery_optimization_continue">தொடரவும்</string>
    <string name="battery_optimization_detected">பேட்டரி ஆப்டிமைசேஷன் கண்டறியப்பட்டது</string>
    <string name="battery_optimization_detected_title">பேட்டரி ஆப்டிமைசேஷன் கண்டறியப்பட்டது</string>
    <string name="battery_optimization_disable_button">பேட்டரி ஆப்டிமைசேஷனை முடக்கு</string>
    <string name="battery_optimization_disabled">பேட்டரி ஆப்டிமைசேஷன் முடக்கப்பட்டது</string>
    <string name="battery_optimization_disabled_title">பேட்டரி ஆப்டிமைசேஷன் முடக்கப்பட்டது</string>
    <string name="battery_optimization_enabled_title">பேட்டரி ஆப்டிமைசேஷன் இயக்கப்பட்டது</string>
    <string name="battery_optimization_explanation">அருகிலுள்ள சாதனங்களுடன் மெஷ் நெட்வொர்க் இணைப்புகளைப் பராமரிக்க Meshora பின்னணியில் இயங்குகிறது. பேட்டரி ஆப்டிமைசேஷன் இந்த இணைப்புகளை தடுக்கலாம், இதனால் செய்திகள் தாமதமாகலாம் அல்லது தவறவிடப்படலாம்.\n\nபேட்டரி ஆப்டிமைசேஷனை முடக்குவது நம்பகமான பியர்-டு-பியர் செய்தி அனுப்புதலை உறுதி செய்கிறது.</string>
    <string name="battery_optimization_explanation_short">மெஷ் இணைப்புகளைப் பராமரிக்க Meshora பின்னணியில் இயங்க வேண்டும். பேட்டரி ஆப்டிமைசேஷன் இந்த இணைப்புகளை தடுக்கலாம்.</string>
    <string name="battery_optimization_not_required">பேட்டரி ஆப்டிமைசேஷன் தேவையில்லை</string>
    <string name="battery_optimization_not_supported_explanation">உங்கள் சாதனத்திற்கு பேட்டரி ஆப்டிமைசேஷன் அமைப்புகள் தேவையில்லை. Meshora சாதாரணமாக இயங்கும்.</string>
    <string name="battery_optimization_not_supported_message">உங்கள் சாதனத்திற்கு பேட்டரி ஆப்டிமைசேஷன் அமைப்புகள் தேவையில்லை. Meshora சாதாரணமாக இயங்கும்.</string>
    <string name="battery_optimization_note">குறிப்பு: Android அமைப்புகள் > ஆப்ஸ் > Meshora > பேட்டரி என்பதில் இந்த அமைப்பை பின்னர் மாற்றலாம்</string>
    <string name="battery_optimization_skip">இப்போதைக்கு தவிர்</string>
    <string name="battery_optimization_success_message">Meshora பின்னணியில் நம்பகமாக இயங்க முடியும்</string>
    <string name="battery_optimization_why_disable">பேட்டரி ஆப்டிமைசேஷனை ஏன் முடக்க வேண்டும்?</string>
