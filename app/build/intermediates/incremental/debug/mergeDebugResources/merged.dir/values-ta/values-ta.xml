    <string name="location_level_city">நகரம்</string>
    <string name="location_level_neighborhood">அக்கம்</string>
    <string name="location_level_province">மாகாணம்</string>
    <string name="location_level_region">பிராந்தியம்</string>
    <string name="location_needs_bullets">• Bluetooth சாதன ஸ்கேனிங்\n• மெஷ் நெட்வொர்க்கில் அருகிலுள்ள பயனர்களைக் கண்டறிதல்\n• ஜியோஹாஷ் அரட்டை அம்சம்\n• கண்காணிப்பு அல்லது இருப்பிட சேகரிப்பு இல்லை</string>
    <string name="location_needs_for">Meshora க்கு இருப்பிட சேவைகள் தேவைப்படுவது:</string>
    <string name="location_notes_description">இந்த இருப்பிடத்திற்கு மற்ற பார்வையாளர்கள் காணும்படி குறுகிய நிரந்தர குறிப்புகளைச் சேர்க்கவும்.</string>
    <string name="location_notes_empty_desc">இந்த இடத்திற்கு முதலில் ஒன்றைச் சேர்க்கவும்.</string>
    <string name="location_notes_empty_title">இதுவரை குறிப்புகள் இல்லை</string>
    <string name="location_notes_input_placeholder">இந்த இடத்திற்கான குறிப்பைச் சேர்க்கவும்</string>
    <string name="location_notes_no_relays_desc">குறிப்புகள் ஜியோ ரிலேகளை நம்பியுள்ளன. இணைப்பைச் சரிபார்த்து மீண்டும் முயற்சிக்கவும்.</string>
    <string name="location_notes_no_relays_title">அருகில் ஜியோ ரிலேகள் இல்லை</string>
    <string name="location_notes_relays_unavailable">ஜியோ ரிலேகள் கிடைக்கவில்லை; குறிப்புகள் இடைநிறுத்தப்பட்டன</string>
    <string name="location_permission_denied">இருப்பிட அனுமதி மறுக்கப்பட்டது. இருப்பிட சேனல்களைப் பயன்படுத்த அமைப்புகளில் இயக்கவும்.</string>
    <string name="location_permission_granted">✓ இருப்பிட அனுமதி வழங்கப்பட்டது</string>
    <string name="location_services_required">இருப்பிட சேவைகள் தேவை</string>
